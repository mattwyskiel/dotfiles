# font
font-family = Hack Nerd Font Mono
font-style = Regular
font-size = 14

# window
background-opacity = 0.9
background-blur = true
maximize = true

theme = Apple System Colors

# Herdr owns terminal keybindings. Clear Ghostty's defaults so its shortcuts
# are forwarded to Herdr, while retaining standard selection and clipboard
# behavior. Copy is forwarded when Ghostty has no selection, allowing Herdr's
# copy mode to work.
keybind = clear
keybind = super+a=select_all
keybind = performable:super+c=copy_to_clipboard:mixed
keybind = super+v=paste_from_clipboard
